# PostgreSQL 数据库配置
POSTGRES_DB=tool_share
POSTGRES_USER=postgres
POSTGRES_PASSWORD=请替换为强密码

# 后端数据库连接配置
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/tool_share
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=请替换为与POSTGRES_PASSWORD相同的密码
SPRING_DATASOURCE_DRIVER_CLASS_NAME=org.postgresql.Driver

# 后端配置
BACKEND_PORT=8080
LOGGING_FILE_NAME=/app/logs/backend.log

# 前端配置
FRONTEND_PORT=3000
NEXT_PUBLIC_BACKEND_BASE_URL=http://backend:8080

# 备份配置
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=7
